# ==============================================================================
# SPSS Backend Environment Configuration Template
# ==============================================================================

# Database Connection URL (SQLite default, can be swapped for PostgreSQL/MySQL)
DATABASE_URL=sqlite:///./spss.db

# JWT Secret Key for Session Authentication (Change in production!)
SECRET_KEY=spss-super-secret-jwt-key-change-in-production-32chars

# JWT Signing Algorithm
ALGORITHM=HS256

# Access Token Expiration in Minutes (480 minutes = 8-hour pharmacy shift)
ACCESS_TOKEN_EXPIRE_MINUTES=480

# NVIDIA NIM API Key (Optional: for AI Dosage Verification via meta/llama-3.1-70b-instruct)
# Get a free key at: https://build.nvidia.com
NVIDIA_API_KEY=

# Server Host & Port Configuration
HOST=0.0.0.0
PORT=8000
