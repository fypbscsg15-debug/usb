# ==============================================================================
# SPSS (Smart Pharmacy Support System) - Unified Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Configuration (FastAPI)
# ------------------------------------------------------------------------------
# Database Connection URL (SQLite default)
DATABASE_URL=sqlite:///./spss.db

# JWT Secret Key for Session Authentication (Change in production!)
SECRET_KEY=spss-super-secret-jwt-key-change-in-production-32chars

# JWT Signing Algorithm
ALGORITHM=HS256

# Access Token Expiration in Minutes (480 minutes = 8-hour shift)
ACCESS_TOKEN_EXPIRE_MINUTES=480

# NVIDIA NIM API Key (Optional: for AI Dosage Verification via meta/llama-3.1-70b-instruct)
# Get a free key at: https://build.nvidia.com
NVIDIA_API_KEY=

# Backend Host & Port
HOST=0.0.0.0
PORT=8000

# ------------------------------------------------------------------------------
# Frontend Configuration (Vite + React)
# ------------------------------------------------------------------------------
# Backend API Base URL
VITE_API_BASE_URL=http://localhost:8000

# Web-only mode (set to true to run purely in browser without Electron desktop shell)
VITE_WEB_ONLY=true

# Frontend Dev Server Port
FRONTEND_PORT=8080
